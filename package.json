{
  "name": "velvlens",
  "version": "0.2.0",
  "description": "VelvLens desktop shell for a local Sub-Store resolver",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "start": "electron .",
    "build:substore": "node scripts/build-substore.mjs",
    "build:runtime": "node scripts/fetch-node-runtime.mjs",
    "test:electron": "node --test tests/electron/*.test.mjs",
    "smoke:substore": "node scripts/smoke-substore.mjs",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "smoke:portable": "node scripts/clean-install-smoke.mjs",
    "verify:package": "node scripts/verify-package.mjs release/win-unpacked",
    "report": "node scripts/write-final-report.mjs",
    "dist": "pnpm build:substore && pnpm build:runtime && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  }
}
